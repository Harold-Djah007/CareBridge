{
  "name": "carebridge-health-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "validate:integrations": "node scripts/validate-integrations.mjs",
    "install:all": "npm ci --prefix server && npm ci --prefix client",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "test:quality": "node server/ci-quality-regression.mjs",
    "test": "node scripts/test-local.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "quality:release": "npm run quality:release --prefix client",
    "certify:local": "npm run audit:release && npm run quality:release",
    "smoke:production": "node scripts/postdeploy-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  }
}
