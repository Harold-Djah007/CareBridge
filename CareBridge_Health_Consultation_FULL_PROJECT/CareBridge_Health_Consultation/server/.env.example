PORT=5000

# Frontend URL used for CORS and Flutterwave redirects.
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
# For multiple trusted browser origins, comma-separate them:
# CLIENT_URLS=http://localhost:5173,https://carebridge.example.com

# Flutterwave: start with TEST MODE credentials.
FLW_SECRET_KEY=FLWSECK_TEST-YOUR-SECRET-KEY-X
FLW_SECRET_HASH=replace-with-a-long-random-webhook-secret
SHOP_NAME=CareBridge Health

# Optional SMTP. Without this, CareBridge keeps in-app email alerts and may use a test inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareBridge Health <no-reply@carebridge.local>
SESSION_DAYS=7
# Optional path override for testing/deployment storage:
# DATA_FILE=/absolute/path/to/carebridge-db.json
