# CareBridge server environment template.
# Copy to server/.env for local development only. Never commit real secrets.

PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Browser/app origin. Production values must use HTTPS.
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
# For multiple trusted browser origins, comma-separate them:
# CLIENT_URLS=https://carebridge.example.com,https://staff.carebridge.example.com

# Persistence.
# Local/demo default: atomic-json. Production: postgres.
PERSISTENCE_PROVIDER=atomic-json
# DATA_FILE=/absolute/path/to/carebridge-db.json
DATABASE_URL=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# Redis coordination/cache/job stream.
REDIS_URL=
REDIS_PREFIX=carebridge
# Production should set this to true so revoked sessions are enforced across instances.
REDIS_SESSION_ENFORCE=false

# Authentication/session hardening.
SESSION_DAYS=7
SESSION_MAX_PER_USER=8
PASSWORD_MIN_LENGTH=10
SESSION_BIND_USER_AGENT=false

# MFA secrets are encrypted with AES-256-GCM using a key derived from this value.
# Production requires a unique random value of at least 32 characters.
MFA_ENCRYPTION_KEY=

# Application-level encrypted disaster-recovery snapshots.
# Production requires a unique random value of at least 32 characters.
BACKUP_ENCRYPTION_KEY=
BACKUP_REQUIRED=false

# Flutterwave. Keep credentials server-side only.
# Development/staging may use a TEST key. Production blocks TEST keys unless
# CAREBRIDGE_ALLOW_TEST_PAYMENT_KEYS=true is explicitly set for a non-live staging deployment.
FLW_SECRET_KEY=FLWSECK_TEST-YOUR-SECRET-KEY-X
FLW_SECRET_HASH=replace-with-a-long-random-webhook-secret
CAREBRIDGE_ALLOW_TEST_PAYMENT_KEYS=false
SHOP_NAME=CareBridge Health

# Production email delivery (SMTP).
# Local development can leave SMTP_HOST blank; production requires a real provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareBridge Health <no-reply@carebridge.local>

# SMART on FHIR backend-services access tokens.
SMART_TOKEN_TTL_SECONDS=3600

# Optional external payer eligibility adapter. Without this, CareBridge uses its
# internal eligibility policy only.
ELIGIBILITY_API_URL=

# Optional production reverse-proxy documentation flag. Set true when HTTPS is
# terminated by Caddy, Cloudflare, a load balancer, or another trusted proxy.
CAREBRIDGE_BEHIND_TLS_PROXY=false

# Optional DICOM/PACS and terminology integrations are configured through the
# authenticated Admin integration APIs rather than hard-coded in this file.
