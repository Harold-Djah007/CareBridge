PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend URL used for CORS and Flutterwave redirects.
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173
# For multiple trusted browser origins, comma-separate them:
# CLIENT_URLS=http://localhost:5173,https://carebridge.example.com

# Flutterwave: start with TEST MODE credentials.
FLW_SECRET_KEY=FLWSECK_TEST-YOUR-SECRET-KEY-X
FLW_SECRET_HASH=replace-with-a-long-random-webhook-secret
SHOP_NAME=CareBridge Health

# Production email delivery (SMTP).
# Works with any normal SMTP provider such as your hospital mail server,
# SendGrid SMTP relay, Mailgun SMTP, Brevo, Amazon SES SMTP, etc.
# In local development, when SMTP_HOST is blank, CareBridge uses an Ethereal
# preview mailbox when available. In production, SMTP must be configured for
# an email to be marked as actually sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Keep true unless your private/internal SMTP server explicitly requires otherwise.
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareBridge Health <no-reply@carebridge.local>

# Authentication/session hardening.
SESSION_DAYS=7
SESSION_MAX_PER_USER=8
PASSWORD_MIN_LENGTH=10
# Optional stricter browser-session binding. Keep false if clients legitimately
# change user-agent strings between requests.
SESSION_BIND_USER_AGENT=false

# Current local/demo durable store. Writes use temp+fsync+atomic rename,
# checksum verification, a write journal and retained backups.
# DATA_FILE=/absolute/path/to/carebridge-db.json

# 9.5 enterprise target: PostgreSQL becomes the production system of record.
# This variable is reserved for the upcoming transactional persistence adapter.
# DATABASE_URL=postgresql://carebridge:password@127.0.0.1:5432/carebridge
