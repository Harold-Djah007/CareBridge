# Copy this file to deploy/.env.production and replace every CHANGE_ME value.
# Never commit deploy/.env.production.

CAREBRIDGE_DOMAIN=carebridge.example.com
CLIENT_URL=https://carebridge.example.com
APP_URL=https://carebridge.example.com

# PostgreSQL password used by the private Docker network.
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# Authentication/session policy.
SESSION_DAYS=7
SESSION_MAX_PER_USER=8
PASSWORD_MIN_LENGTH=10
SESSION_BIND_USER_AGENT=false

# Dedicated encryption secrets. Use different random values.
MFA_ENCRYPTION_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FOR_MFA
BACKUP_ENCRYPTION_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FOR_BACKUPS

# Flutterwave production credentials.
FLW_SECRET_KEY=CHANGE_ME_WITH_FLUTTERWAVE_LIVE_SECRET_KEY
FLW_SECRET_HASH=CHANGE_ME_WITH_A_LONG_RANDOM_FLUTTERWAVE_WEBHOOK_SECRET
CAREBRIDGE_ALLOW_TEST_PAYMENT_KEYS=false
SHOP_NAME=CareBridge Health

# SMTP production delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=CHANGE_ME_WITH_SMTP_USERNAME
SMTP_PASS=CHANGE_ME_WITH_SMTP_PASSWORD
SMTP_FROM=CareBridge Health <no-reply@carebridge.example.com>

# Runtime / observability.
LOG_LEVEL=info
REDIS_PREFIX=carebridge
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
SMART_TOKEN_TTL_SECONDS=3600

# Optional external payer eligibility integration.
ELIGIBILITY_API_URL=
